diff --git a/CMakeLists.txt b/CMakeLists.txt
index f8ee65a..7172077 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -183,18 +183,13 @@ if(MLX_BUILD_METAL)
   # Probe the macOS SDK only on Darwin. On iOS the caller selects the SDK, so
   # version detection is deferred and the baseline Metal feature set is used.
   if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
-    # Get the host macOS version.
-    execute_process(
-      COMMAND sw_vers -productVersion
-      OUTPUT_VARIABLE MACOS_VERSION
-      OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
+    # Nix build: no Xcode/xcrun and no host probing. Both the "host" macOS
+    # version and the SDK version are pinned to the nixpkgs apple-sdk version
+    # so the derivation stays pure and reproducible across builders.
+    set(MACOS_VERSION @sdkVersion@)
     message(STATUS "Building on macOS ${MACOS_VERSION}")
 
-    # Get macOS SDK version.
-    execute_process(
-      COMMAND xcrun -sdk macosx --show-sdk-version
-      OUTPUT_VARIABLE MACOS_SDK_VERSION
-      OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
+    set(MACOS_SDK_VERSION @sdkVersion@)
     if(MACOS_SDK_VERSION VERSION_LESS 14.0)
       message(
         FATAL_ERROR
@@ -211,14 +206,10 @@ if(MLX_BUILD_METAL)
     endif()
     message(STATUS "Building for macOS ${CMAKE_OSX_DEPLOYMENT_TARGET}")
 
-    # Get Metal version.
+    # Nix build: the Metal language version is supplied by the pinned
+    # metal-toolchain derivation instead of probing __METAL_VERSION__.
     set(XCRUN_FLAGS "-mmacosx-version-min=${CMAKE_OSX_DEPLOYMENT_TARGET}")
-    execute_process(
-      COMMAND
-        zsh "-c"
-        "echo \"__METAL_VERSION__\" | xcrun -sdk macosx metal ${XCRUN_FLAGS} -E -x metal -P - | tail -1"
-      OUTPUT_VARIABLE MLX_METAL_VERSION
-      OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
+    set(MLX_METAL_VERSION @metalVersion@)
     message(STATUS "Metal version: ${MLX_METAL_VERSION}")
   else()
     set(MLX_METAL_VERSION 0)
diff --git a/cmake/extension.cmake b/cmake/extension.cmake
index 13db804..4dc117f 100644
--- a/cmake/extension.cmake
+++ b/cmake/extension.cmake
@@ -36,7 +36,7 @@ macro(mlx_build_metallib)
   add_custom_command(
     OUTPUT ${MTLLIB_BUILD_TARGET}
     COMMAND
-      xcrun -sdk macosx metal
+      metal -fmodules-cache-path=${CMAKE_BINARY_DIR}/metal-cache
       "$<LIST:TRANSFORM,${MTLLIB_INCLUDE_DIRS},PREPEND,-I>"
       ${MTLLIB_COMPILE_OPTIONS} ${MTLLIB_SOURCES} -o ${MTLLIB_BUILD_TARGET}
     DEPENDS ${MTLLIB_DEPS} ${MTLLIB_SOURCES}
diff --git a/mlx/backend/metal/kernels/CMakeLists.txt b/mlx/backend/metal/kernels/CMakeLists.txt
index 30729c0..3991ee5 100644
--- a/mlx/backend/metal/kernels/CMakeLists.txt
