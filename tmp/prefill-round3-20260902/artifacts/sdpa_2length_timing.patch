+
+# ---- ROUND-3 SDPA per-call timing (env-gated, EXO_DSV4_SDPA_CALL_PROFILE=1) ----
+# Directly wraps the `attn.sdpa` SDPA call site(s) in perf_counter so we
+# measure PER-CALL ABSOLUTE milliseconds, NOT ms/token (a per-call vs
+# per-token units conflation invalidated the round-2 closure — see
+# tmp/prefill-round2/findings/sdpa-reopen.md).
+#
+# MLX IS LAZY: a bare perf_counter around the call measures only ENQUEUE
+# (graph build), not execution. The kernel runs asynchronously when its
+# output is first forced. The existing `finalize(x)` / `span()` helpers in
+# mlx_lm/profiler.py are NO-OPS when no profiler hook is registered
+# (profiler.py:109-113), so they cannot be relied on here. This gate
+# inserts its OWN explicit `mx.eval(out)` on the SDPA output immediately
+# BEFORE the end timestamp, so the perf_counter delta reflects real GPU
+# kernel time for that one call. This is the mandatory correctness
+# requirement for round 3.
+#
+# Output: one `[SDPA-CALL] ...` line per measured call, written to stderr
+# (captured in ~/exo.log under `Runner stderr:` lines) — no SIGUSR1, no
+# autodump dependency, no cluster-side file writes; the analyzer greps the
+# SSH-pulled log. The probe is a PER-CALL emitter (n >= 5 needed per
+# length); the analysis script separates the FIRST call at each length
+# (warmup — excluded) from steady-state.
+#
+# Cost when OFF: one module-level bool read per `attn.sdpa` site (~ns).
+# Zero env-var reads, zero perf_counter calls, zero mx.eval in the hot path.
+_SDPA_CALL_PROFILE = bool(os.environ.get("EXO_DSV4_SDPA_CALL_PROFILE"))
+_SDPA_CALL_PERF = _bp_time.perf_counter
+
+
+def _sdpacall_mark_start() -> float:
+    """Return a perf_counter start timestamp when profiling is on, else 0.0."""
+    return _SDPA_CALL_PERF()
+
+
+def _sdpacall_record(out: mx.array, layer_idx: int, t0: float, tag: str) -> None:
+    """Force lazy evaluation of the SDPA output, then emit a per-call line.
+
+    ``mx.eval(out)`` is the MANDATORY lazy-eval sync: without forcing the
+    graph here, the perf_counter delta would measure only ENQUEUE time, not
+    the GPU kernel. The eval sits INSIDE the timed window (immediately
+    before the end timestamp), matching how SpanProfilerHook's sync mode
+    drains. ``out`` is the SDPA result (already an mx.array at this point —
+    under the sparse branch a concatenation of tile outputs).
+    """
+    mx.eval(out)
+    ms = (_SDPA_CALL_PERF() - t0) * 1000.0
+    import sys as _s
+    _s.stderr.write(
+        f"[SDPA-CALL] {tag} L={layer_idx} ms={ms:.3f}\n"
+    )
+    _s.stderr.flush()
+
+
