 _BUILD_PROBE_ENABLED = bool(os.environ.get("MLX_BUILD_PROBE"))
 _BUILD_PROBE_LOG_EVERY = int(os.environ.get("MLX_BUILD_PROBE_LOG_EVERY", "8"))
